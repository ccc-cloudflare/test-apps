// wrangler 設定：https://developers.cloudflare.com/workers/wrangler/configuration/
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "myshop",
	"main": "src/worker.js",
	"compatibility_date": "2025-11-01",
	// 部署前先建立資料庫並把 id 填進來：
	//   npx wrangler d1 create myshop-db
	//   npx wrangler d1 execute myshop-db --remote --file=schema.sql
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "myshop-db",
			"database_id": "336ac33e-6d0c-4d03-a1d0-10b6766d1865"
		}
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"observability": {
		"enabled": true
	}
	// 登入的 cookie 用 HMAC 簽章，部署前要設定密鑰：
	//   npx wrangler secret put AUTH_SECRET
}